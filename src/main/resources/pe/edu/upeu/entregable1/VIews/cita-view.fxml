<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>



<VBox minHeight="0" minWidth="0" prefHeight="615" prefWidth="820" spacing="14" style="-fx-background-color: #F6FAFB;" styleClass="vet-root" stylesheets="@veterinaria.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.entregable1.Controladores.CItaControler">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B3557;" text="CITAS" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="txtBuscar" minWidth="0" prefHeight="32" prefWidth="300" promptText="ID de cita" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnBuscar" onAction="#handleSearch" minWidth="100" prefHeight="34" style="-fx-background-color: #0E7C86; -fx-text-fill: white;" text="Buscar" />
            <Button fx:id="btnMostrarTodos" onAction="#handleListAll" minWidth="130" prefHeight="34" style="-fx-background-color: white; -fx-border-color: #0E7C86; -fx-text-fill: #0E7C86;" text="Mostrar todos" />
        </HBox>
        <TableView fx:id="tblCitas" minHeight="100" minWidth="0" prefHeight="400" prefWidth="780" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Todavía no hay registros" />
            </placeholder>
            <columns>
                <TableColumn fx:id="colId" minWidth="55" prefWidth="60" text="ID" />
                <TableColumn fx:id="colMascota" minWidth="85" prefWidth="120" text="Mascota" />
                <TableColumn fx:id="colVeterinario" minWidth="85" prefWidth="120" text="Veterinario" />
                <TableColumn fx:id="colFecha" minWidth="85" prefWidth="120" text="Fecha" />
                <TableColumn fx:id="colHora" minWidth="85" prefWidth="120" text="Hora" />
                <TableColumn fx:id="colMotivo" minWidth="85" prefWidth="120" text="Motivo" />
                <TableColumn fx:id="colEstado" minWidth="85" prefWidth="120" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="btnNuevo" onAction="#handleNew" prefHeight="34" prefWidth="110" style="-fx-background-color: #0E7C86; -fx-text-fill: white;" text="Nuevo" />
            <Button fx:id="btnEditar" onAction="#handleEdit" prefHeight="34" prefWidth="110" style="-fx-background-color: #0B3557; -fx-text-fill: white;" text="Editar" />
            <Button fx:id="btnEliminar" onAction="#handleDelete" prefHeight="34" prefWidth="145" style="-fx-background-color: #47758A; -fx-text-fill: white;" text="Eliminar" />
        </HBox>
        <Label fx:id="lblMensaje" minHeight="18" prefWidth="930" text="" wrapText="true" />
    </children>
</VBox>
