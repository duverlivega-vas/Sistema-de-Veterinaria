<?xml version="1.0" ?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- Diseño visual: los botones aún no tienen acciones. -->
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" prefHeight="615" prefWidth="820" style="-fx-background-color: #F6FAFB;" fx:controller="pe.edu.upeu.entregable1.Controladores.ConsultaControler" stylesheets="@veterinaria.css" styleClass="vet-root" minWidth="0" minHeight="0" spacing="14">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <children>
        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B3557;" text="CONSULTAS"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscar" prefHeight="32" prefWidth="350" promptText="ID de cita o mascota" HBox.hgrow="ALWAYS" minWidth="0"/>
            <Button fx:id="btnBuscar" prefHeight="34" prefWidth="110" style="-fx-background-color: #0E7C86; -fx-text-fill: white;" text="Buscar" minWidth="110"/>
            <Button fx:id="btnMostrarTodos" prefHeight="34" prefWidth="118.0" style="-fx-background-color: white; -fx-border-color: #0E7C86; -fx-text-fill: #0E7C86;" text="Mostrar todos" minWidth="118.0"/>
        </HBox>
        <TableView fx:id="tblConsultas" prefHeight="400" prefWidth="780" VBox.vgrow="ALWAYS" minHeight="100" minWidth="0">
            <placeholder>
                <Label text="Todavía no hay registros"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colId" prefWidth="60" text="ID" minWidth="55"/>
                <TableColumn fx:id="colCita" prefWidth="120" text="Cita" minWidth="85"/>
                <TableColumn fx:id="colMascota" prefWidth="120" text="Mascota" minWidth="85"/>
                <TableColumn fx:id="colDiagnostico" prefWidth="120" text="Diagnóstico" minWidth="85"/>
                <TableColumn fx:id="colObservaciones" prefWidth="120" text="Observaciones" minWidth="85"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <FlowPane hgap="10" vgap="8">
            <Button fx:id="btnNuevo" prefHeight="34" prefWidth="110" style="-fx-background-color: #0E7C86; -fx-text-fill: white;" text="Nuevo"/>
            <Button fx:id="btnEditar" prefHeight="34" prefWidth="110" style="-fx-background-color: #0B3557; -fx-text-fill: white;" text="Editar"/>
            <Button fx:id="btnVerTratamientos" prefHeight="34" prefWidth="145" style="-fx-background-color: #47758A; -fx-text-fill: white;" text="Tratamientos"/>
        </FlowPane>
        <Label fx:id="lblMensaje" prefWidth="930" text="" minHeight="18" wrapText="true"/>
    </children>
</VBox>
