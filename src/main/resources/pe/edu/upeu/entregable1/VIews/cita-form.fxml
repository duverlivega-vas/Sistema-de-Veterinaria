<?xml version="1.0" ?>
<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- Formulario compartido para registrar y editar. Controlador y eventos pendientes. -->
<GridPane fx:controller="pe.edu.upeu.entregable1.Controladores.CitaFormControler" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" hgap="12" prefHeight="474" prefWidth="380" style="-fx-background-color: #F6FAFB;" vgap="12" stylesheets="@veterinaria.css" styleClass="vet-root" minWidth="380">
    <padding>
        <Insets bottom="24" left="24" right="24" top="24"/>
    </padding>
    <columnConstraints>
        <ColumnConstraints hgrow="NEVER" percentWidth="35"/>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="65"/>
    </columnConstraints>
    <children>
        <Label fx:id="lblTitulo" style="-fx-font-size: 23; -fx-font-weight: bold; -fx-text-fill: #0B3557;" text="Datos de cita" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" wrapText="true" minWidth="0"/>
        <Label style="" text="Mascota" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="1" minWidth="0"/>
        <ComboBox fx:id="cmbMascota" maxWidth="Infinity" prefHeight="30" prefWidth="200" promptText="Seleccionar" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" minWidth="0"/>
        <Label style="" text="Veterinario" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="2" minWidth="0"/>
        <ComboBox fx:id="cmbVeterinario" maxWidth="Infinity" prefHeight="30" prefWidth="200" promptText="Seleccionar" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" minWidth="0"/>
        <Label style="" text="Fecha" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="3" minWidth="0"/>
        <DatePicker fx:id="dpFecha" maxWidth="Infinity" prefHeight="30" prefWidth="200" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" minWidth="0"/>
        <Label style="" text="Hora" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="4" minWidth="0"/>
        <TextField fx:id="txtHora" maxWidth="Infinity" prefHeight="30" prefWidth="200" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="4" minWidth="0"/>
        <Label style="" text="Motivo" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="5" minWidth="0"/>
        <TextArea fx:id="txtMotivo" maxWidth="Infinity" prefHeight="70" prefWidth="200" wrapText="true" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="5" minWidth="0"/>
        <Label style="" text="Estado" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="6" minWidth="0"/>
        <ComboBox fx:id="cmbEstado" maxWidth="Infinity" prefHeight="30" prefWidth="200" promptText="Seleccionar" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="6" minWidth="0">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Pendiente"/>
                    <String fx:value="Atendida"/>
                    <String fx:value="Cancelada"/>
                </FXCollections>
            </items>
        </ComboBox>
        <HBox alignment="CENTER_RIGHT" spacing="12" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="7">
            <Button fx:id="btnGuardar" prefHeight="34" prefWidth="110" style="-fx-background-color: #0E7C86; -fx-text-fill: white;" text="Guardar"/>
            <Button fx:id="btnCancelarEdicion" prefHeight="34" prefWidth="110" style="-fx-background-color: white; -fx-border-color: #0E7C86; -fx-text-fill: #0E7C86;" text="Cancelar"/>
        </HBox>
        <Label fx:id="lblMensaje" prefWidth="600" text="" wrapText="true" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="8" minWidth="0"/>
    </children>
    <rowConstraints>
        <RowConstraints/>
        <RowConstraints/>
        <RowConstraints/>
        <RowConstraints/>
        <RowConstraints/>
        <RowConstraints/>
        <RowConstraints/>
        <RowConstraints/>
        <RowConstraints/>
    </rowConstraints>
</GridPane>
