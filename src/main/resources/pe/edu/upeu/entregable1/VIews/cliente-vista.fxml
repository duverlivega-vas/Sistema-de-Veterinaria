<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox minHeight="0" minWidth="0" prefHeight="615" prefWidth="820" spacing="14" style="-fx-background-color: #F3F7FA; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.entregable1.Controladores.ClienteControler">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #0B3557;" text="CLIENTES" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="txtBuscar" prefHeight="34.0" prefWidth="244.0" promptText="DNI (búsqueda automática)" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D5E1E9; -fx-border-radius: 8; -fx-padding: 7 10; -fx-text-fill: #173B53; -fx-prompt-text-fill: #8A9BA7;" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnBuscar" minWidth="100" onAction="#handleSearch" prefHeight="34" style="-fx-background-color: #0E596B; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Buscar" />
            <Button fx:id="btnMostrarTodos" minWidth="130" onAction="#handleListAll" prefHeight="34" style="-fx-background-color: white; -fx-border-color: #0E596B; -fx-border-width: 1.2; -fx-text-fill: #0E596B; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Mostrar todos" />
        </HBox>
        <TableView fx:id="tblClientes" minHeight="100" minWidth="0" prefHeight="400" prefWidth="780" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #DCE6EC; -fx-border-radius: 12; -fx-control-inner-background: white; -fx-control-inner-background-alt: #F8FBFC; -fx-table-cell-border-color: #EAF0F3;" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Todavía no hay registros" />
            </placeholder>
            <columns>

                <TableColumn fx:id="colNumero" maxWidth="64" minWidth="64" prefWidth="64" resizable="false" sortable="false" style="-fx-alignment: CENTER;" text="N°" />
                <TableColumn fx:id="colId" prefWidth="30" text="ID" visible="false" />
                <TableColumn fx:id="colNombres" minWidth="85" prefWidth="120" text="Nombres" />
                <TableColumn fx:id="colApellidos" minWidth="85" prefWidth="120" text="Apellidos" />
                <TableColumn fx:id="colDni" minWidth="85" prefWidth="120" text="DNI" />
                <TableColumn fx:id="colTelefono" minWidth="85" prefWidth="120" text="Teléfono" />
                <TableColumn fx:id="colDireccion" minWidth="85" prefWidth="120" text="Dirección" />
                <TableColumn fx:id="colEstado" minWidth="85" prefWidth="120" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="btnNuevo" onAction="#handleNew" prefHeight="34" prefWidth="110" style="-fx-background-color: #EFA30E; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(20,55,75,0.16), 8, 0.08, 0, 2);" text="Nuevo" />
            <Button fx:id="btnEditar" onAction="#handleEdit" prefHeight="34" prefWidth="110" style="-fx-background-color: #014074; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Editar" />
            <Button fx:id="btnEliminar" onAction="#handleDelete" prefHeight="34" prefWidth="145" style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Eliminar" />
        </HBox>
        <Label fx:id="lblMensaje" minHeight="18" prefWidth="930" text="" wrapText="true" />
    </children>
</VBox>
