<?xml version="1.0" ?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<?import javafx.geometry.Insets?>
<VBox fx:controller="pe.edu.upeu.entregable1.Controladores.UsuarioControler" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="820" prefHeight="615" style="-fx-background-color: #F6FAFB;" stylesheets="@veterinaria.css" styleClass="vet-root" minWidth="0" minHeight="0" spacing="14">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <children>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="USUARIOS" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B3557;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNuevo" onAction="#handleNew" prefWidth="110" prefHeight="34" text="Nuevo" style="-fx-background-color: #0E7C86; -fx-text-fill: white;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscar" promptText="Buscar por DNI" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnBuscar" onAction="#handleSearch" text="Buscar"/>
            <Button fx:id="btnMostrarTodos" onAction="#handleListAll" text="Mostrar todos"/>
        </HBox>
        <TableView fx:id="tblUsuarios" prefWidth="780" prefHeight="400" VBox.vgrow="ALWAYS" minHeight="100" minWidth="0">
            <placeholder>
                <Label text="Todavía no hay registros"/>
            </placeholder>
            <columns>

                <TableColumn fx:id="colNumero" minWidth="64" prefWidth="64" maxWidth="64" text="N°" sortable="false" resizable="false" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colId" prefWidth="30" text="ID" visible="false" />
                <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="120" minWidth="85"/>
                <TableColumn fx:id="colNombres" text="Nombres" prefWidth="120" minWidth="85"/>
                <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="120" minWidth="85"/>
                <TableColumn fx:id="colDni" text="DNI" prefWidth="120" minWidth="85"/>
                <TableColumn fx:id="colTipo" text="Tipo de usuario" prefWidth="120" minWidth="85"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="btnEditar" onAction="#handleEdit" prefWidth="110" prefHeight="34" text="Editar" style="-fx-background-color: #0B3557; -fx-text-fill: white;"/>
            <Button fx:id="btnEliminar" onAction="#handleDelete" prefWidth="110" prefHeight="34" text="Eliminar" style="-fx-background-color: #47758A; -fx-text-fill: white;"/>
        </HBox>
        <Label fx:id="lblMensaje" prefWidth="930" text="" minHeight="18" wrapText="true"/>
    </children>
</VBox>
