<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox minHeight="0" minWidth="0" prefHeight="615" prefWidth="820" spacing="14" style="-fx-background-color: #F3F7FA; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.entregable1.Controladores.CItaControler">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #0B3557;" text="CITAS" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNuevo" onAction="#handleNew" prefHeight="34" prefWidth="95" style="-fx-background-color: #EFA30E; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(20,55,75,0.16), 8, 0.08, 0, 2);" text="Nuevo" />
        </HBox>

        <TableView fx:id="tblCitas" minHeight="100" minWidth="0" prefHeight="400" prefWidth="780" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #DCE6EC; -fx-border-radius: 12; -fx-control-inner-background: white; -fx-control-inner-background-alt: #F8FBFC; -fx-table-cell-border-color: #EAF0F3;" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Todavía no hay registros" />
            </placeholder>
            <columns>

                <TableColumn fx:id="colNumero" maxWidth="64" minWidth="64" prefWidth="64" resizable="false" sortable="false" style="-fx-alignment: CENTER;" text="N°" />
                <TableColumn fx:id="colId" prefWidth="30" text="ID" visible="false" />
                <TableColumn fx:id="colMascota" minWidth="85" prefWidth="120" text="Mascota" />
                <TableColumn fx:id="colVeterinario" minWidth="85" prefWidth="120" text="Veterinario" />
                <TableColumn fx:id="colFecha" minWidth="85" prefWidth="120" text="Fecha" />
                <TableColumn fx:id="colHora" minWidth="85" prefWidth="120" text="Hora" />
                <TableColumn fx:id="colMotivo" minWidth="85" prefWidth="120" text="Motivo" />
                <TableColumn fx:id="colEstado" minWidth="85" prefWidth="120" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="btnEditar" onAction="#handleEdit" prefHeight="34" prefWidth="95" style="-fx-background-color: #014074; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Editar" />
            <Button fx:id="btnEliminar" onAction="#handleDelete" prefHeight="34" prefWidth="100" style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Eliminar" />
            <Button fx:id="btnIniciarAtencion" onAction="#handleIniciarAtencion" prefHeight="34" prefWidth="140" style="-fx-background-color: #014074; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Iniciar atención" />
            <Button fx:id="btnMarcarAtendida" onAction="#handleMarcarAtendida" prefHeight="34" prefWidth="105" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Finalizar" />
            <Button fx:id="btnCancelarCita" onAction="#handleCancelarCita" prefHeight="34" prefWidth="120" style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Cancelar cita" />
        </HBox>
        <Label fx:id="lblMensaje" minHeight="18" prefWidth="930" text="" wrapText="true" />
    </children>
</VBox>
