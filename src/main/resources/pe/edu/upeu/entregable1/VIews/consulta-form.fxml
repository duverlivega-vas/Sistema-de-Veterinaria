<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>



<GridPane fx:controller="pe.edu.upeu.entregable1.Controladores.ConsultaFormControler" hgap="12" minWidth="380" prefHeight="417" prefWidth="380" vgap="12" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-background-radius: 14; -fx-border-color: #DCE6EC; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(20,55,75,0.08), 16, 0.08, 0, 4);">
    <padding>
        <Insets bottom="24" left="24" right="24" top="24" />
    </padding>
    <columnConstraints>
        <ColumnConstraints hgrow="NEVER" percentWidth="35" />
        <ColumnConstraints hgrow="ALWAYS" percentWidth="65" />
    </columnConstraints>
    <children>
        <Label fx:id="lblTitulo" minWidth="0" style="-fx-font-size: 23; -fx-font-weight: bold; -fx-text-fill: #0B3557;" text="Datos de consulta" wrapText="true" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" />
        <Label minWidth="0" style="" text="Cita" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbCita" maxWidth="Infinity" minWidth="0" prefHeight="30" prefWidth="41.0" promptText="Seleccione una cita atendida" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1"  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D5E1E9; -fx-border-radius: 8; -fx-padding: 7 10; -fx-text-fill: #173B53; -fx-prompt-text-fill: #8A9BA7;"/>
        <Label minWidth="0" style="" text="Diagnóstico" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextArea fx:id="txtDiagnostico" maxWidth="Infinity" minWidth="0" prefHeight="70" prefWidth="200" wrapText="true" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2"  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D5E1E9; -fx-border-radius: 8; -fx-padding: 7 10; -fx-text-fill: #173B53; -fx-prompt-text-fill: #8A9BA7;"/>
        <Label minWidth="0" style="" text="Observaciones" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextArea fx:id="txtObservaciones" maxWidth="Infinity" minWidth="0" prefHeight="70" prefWidth="200" wrapText="true" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3"  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D5E1E9; -fx-border-radius: 8; -fx-padding: 7 10; -fx-text-fill: #173B53; -fx-prompt-text-fill: #8A9BA7;"/>
        <HBox alignment="CENTER_RIGHT" spacing="12" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
            <Button fx:id="btnGuardar" onAction="#handleSaved" defaultButton="true" prefHeight="34" prefWidth="110" style="-fx-background-color: #EFA30E; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(20,55,75,0.16), 8, 0.08, 0, 2);" text="Guardar" />
            <Button fx:id="btnCancelarEdicion" onAction="#handleCancel" cancelButton="true" prefHeight="34" prefWidth="110" style="-fx-background-color: white; -fx-border-color: #E98554; -fx-border-width: 1.5; -fx-text-fill: #C55C32; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;" text="Cancelar" />
        </HBox>
        <Label fx:id="lblMensaje" wrapText="true" GridPane.columnSpan="2" GridPane.rowIndex="5"/>
    </children>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>
</GridPane>
