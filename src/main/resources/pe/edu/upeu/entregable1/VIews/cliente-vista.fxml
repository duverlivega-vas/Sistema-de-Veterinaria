<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox minHeight="0" minWidth="0" prefHeight="615" prefWidth="820" spacing="14" style="-fx-background-color: #F6FAFB;" styleClass="vet-root" stylesheets="@veterinaria.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.entregable1.Controladores.ClienteControler">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B3557;" text="CLIENTES" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <ComboBox fx:id="cmbCriterioBusqueda" minWidth="90" prefWidth="90" value="ID">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="ID" />
                        <String fx:value="DNI" />
                    </FXCollections>
                </items>
            </ComboBox>
            <TextField fx:id="txtBuscar" minWidth="0" prefHeight="32" prefWidth="300" promptText="ID o DNI según el criterio" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnBuscar" onAction="#handleSearch" minWidth="100" prefHeight="34" style="-fx-background-color: #0E7C86; -fx-text-fill: white;" text="Buscar" />
            <Button fx:id="btnMostrarTodos" onAction="#handleListAll" minWidth="130" prefHeight="34" style="-fx-background-color: white; -fx-border-color: #0E7C86; -fx-text-fill: #0E7C86;" text="Mostrar todos" />
        </HBox>
        <TableView fx:id="tblClientes" minHeight="100" minWidth="0" prefHeight="400" prefWidth="780" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Todavía no hay registros" />
            </placeholder>
            <columns>
                <TableColumn fx:id="colId" minWidth="55" prefWidth="60" text="ID" />
                <TableColumn fx:id="colNombres" minWidth="85" prefWidth="120" text="Nombres" />
                <TableColumn fx:id="colApellidos" minWidth="85" prefWidth="120" text="Apellidos" />
                <TableColumn fx:id="colDni" minWidth="85" prefWidth="120" text="DNI" />
                <TableColumn fx:id="colTelefono" minWidth="85" prefWidth="120" text="Teléfono" />
                <TableColumn fx:id="colDireccion" minWidth="85" prefWidth="120" text="Dirección" />
                <TableColumn fx:id="colEstado" minWidth="85" prefWidth="120" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="btnNuevo" onAction="#handleNew" prefHeight="34" prefWidth="110" style="-fx-background-color: #0E7C86; -fx-text-fill: white;" text="Nuevo" />
            <Button fx:id="btnEditar" onAction="#handleEdit" prefHeight="34" prefWidth="110" style="-fx-background-color: #0B3557; -fx-text-fill: white;" text="Editar" />
            <Button fx:id="btnEliminar" onAction="#handleDelete" prefHeight="34" prefWidth="145" style="-fx-background-color: #47758A; -fx-text-fill: white;" text="Eliminar" />
        </HBox>
        <Label fx:id="lblMensaje" minHeight="18" prefWidth="930" text="" wrapText="true" />
    </children>
</VBox>
